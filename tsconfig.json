{
  // The editor + typecheck config (`tsc` never emits; Vite builds `dist/`).
  // It includes the tests so VS Code applies `paths` to them too: VS Code only
  // uses the `tsconfig.json` nearest a file, and a file outside it falls into
  // an "inferred project" that ignores `paths`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "types": ["node"],
    // Import alias: `@/foo.js` -> `src/foo.ts`. Keep in sync with
    // `resolve.alias` in vite.config.ts. Imports keep the `.js` extension.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
